{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cognitive Conversation Decision",
  "type": "object",
  "required": ["type", "intent_hash", "date", "source", "session_id", "decision", "status"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["Decision", "Actor", "Constraint", "Alternative"]
    },
    "intent_hash": {
      "type": "string",
      "pattern": "^0x[A-Z0-9_]+$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "source": {
      "type": "string",
      "enum": ["conversation"]
    },
    "session_id": {
      "type": "string"
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "options_considered": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files_impacted": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repos_impacted": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests_written": {
      "type": "integer"
    },
    "governance_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "phi_cps": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "accepted", "rejected", "superseded"]
    }
  }
}
